# Скопируй в .env.local и заполни значениями из Supabase (Settings → API Keys).
# Без этих переменных сайт работает на демо-данных из src/lib/vacancies.ts.
NEXT_PUBLIC_SUPABASE_URL=
# Сюда идёт Publishable key (sb_publishable_...) — новый формат вместо anon.
# Он открытый по замыслу: доступ ограничивают RLS-политики, а не секретность ключа.
# Secret key (sb_secret_...) здесь не место — только на сервере, для импортёра.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
