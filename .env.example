# Скопируй в .env.local и заполни значениями из Supabase (Settings → API Keys).
# Без этих переменных сайт работает на демо-данных из src/lib/vacancies.ts.
NEXT_PUBLIC_SUPABASE_URL=
# Сюда идёт Publishable key (sb_publishable_...) — новый формат вместо anon.
# Он открытый по замыслу: доступ ограничивают RLS-политики, а не секретность ключа.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ниже — секреты. НЕ NEXT_PUBLIC_, в браузер не попадают. Не коммитить значения,
# не присылать в чат — только напрямую в .env.local и в Vercel Environment Variables.

# Settings → API Keys → Secret keys (sb_secret_...). Обходит RLS — только для
# серверного кода без пользовательского контекста (src/lib/supabase/service.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Любая случайная строка — защищает /api/import от чужих запросов.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
IMPORT_SECRET=

# Для ежедневного Vercel Cron. Его значение Vercel автоматически передаёт как
# Authorization: Bearer <CRON_SECRET>; добавьте тот же секрет в Vercel → Settings → Environment Variables.
CRON_SECRET=
